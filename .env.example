# Non-secret, server-only. Defaults to info when omitted.
LOG_LEVEL=info
# Identity is lazy: these are needed only for /login, /register and the real workspace.
# Provide local values privately. No credentials have defaults in application code.
# APP_ORIGIN=http://127.0.0.1:3000
# DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@127.0.0.1:5432/leadflow_local
# AUTH_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Migration only; never use the provisioner URL as DATABASE_URL.
# IDENTITY_MIGRATION_URL=postgresql://PROVISIONER:PRIVATE_PASSWORD@127.0.0.1:5432/leadflow_local
# IDENTITY_RUNTIME_ROLE=leadflow_runtime
